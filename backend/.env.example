# MiraGuide Backend Environment Variables
# Copy to .env and fill in values

# Application
APP_NAME=MiraGuide
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8787

# Database
DATABASE_URL=postgresql+asyncpg://miraguide:miraguide@localhost:5432/miraguide
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# AI Providers (at least one required for production)
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-1.5-pro

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# AI Provider Selection
DEFAULT_VISION_PROVIDER=demo
DEFAULT_TEXT_PROVIDER=demo
DEFAULT_OCR_PROVIDER=demo
DEFAULT_STT_PROVIDER=demo
DEFAULT_TTS_PROVIDER=demo

# Demo Mode (used when no API keys configured)
DEMO_MODE=true

# File Upload
MAX_FILE_SIZE_MB=8
ALLOWED_MIME_TYPES=["image/jpeg", "image/png", "image/webp", "image/gif", "application/pdf"]
ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png", ".webp", ".gif", ".pdf"]

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# Security
SECRET_KEY=your-secret-key-change-in-production
API_KEY_HEADER=X-API-Key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Request ID Header
REQUEST_ID_HEADER=X-Request-ID